# GEMINI_API_KEY: Server-side Gemini API key (if needed)
GEMINI_API_KEY=

# ANTHROPIC_API_KEY: Mandatory API key for Claude transcript analysis and clip selection
# Obtain from https://console.anthropic.com/
ANTHROPIC_API_KEY=

# CLAUDE_MODEL: Claude model identifier for clip selection analysis
# Supported: claude-3-7-sonnet-20250219, claude-3-5-sonnet-20241022, claude-3-5-haiku-20241022
CLAUDE_MODEL=claude-3-7-sonnet-20250219

# Application Workspace & Defaults
WORKSPACE_DIR=ShortsForge_Output
DEFAULT_CLIP_COUNT=5
MIN_CLIP_DURATION=20
MAX_CLIP_DURATION=90
DEFAULT_CROP_MODE=center
VIDEO_QUALITY=high
PORT=3000
